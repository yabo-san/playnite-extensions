<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:popt="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <BitmapImage x:Key="TrayIcon" UriSource="{ThemeFile 'Images/applogo.ico'}" RenderOptions.BitmapScalingMode="LowQuality" popt:Freeze="True"/>
    <BitmapImage x:Key="TrayIconWhite" UriSource="{ThemeFile 'Images/applogo_blue.ico'}" RenderOptions.BitmapScalingMode="LowQuality" popt:Freeze="True"/>

    <TextBlock x:Key="FullscreenModeIcon" Text="&#xe7f4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <TextBlock x:Key="AddGameIcon" Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <TextBlock x:Key="UpdateDbIcon" Text="&#xe117;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="AboutPlayniteIcon" Text="" FontFamily="{DynamicResource FontFamily}" />
    <TextBlock x:Key="ExitIcon" Text="&#xe7e8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="OrangeRed"/>
    <TextBlock x:Key="SettingsIcon" Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="AddonsIcon" Text="&#xea86;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="PlayIcon" Text="&#xF5B0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="InstallIcon" Text="&#xe118;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="LinksIcon" Text="&#xe167;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="OpenFolderIcon" Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="InstallSizeIcon" Text="&#xE8EF;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="DesktopShortcutIcon" Text="&#xE836;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="AddFavoritesIcon" Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="Yellow"/>
    <TextBlock x:Key="RemoveFavoritesIcon" Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="Yellow"/>
    <TextBlock x:Key="HideIcon" Text="&#xe052;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="UnHideIcon" Text="&#xed1a;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="HdrIcon" Text="&#xeef2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="EditGameIcon" Text="&#xEF60;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="RemoveGameIcon" Text="&#xe107;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="OrangeRed"/>
    <TextBlock x:Key="DiceIcon" Text="&#xE8B1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="ManualIcon" Text="&#xe82d;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="BackupIcon" Text="&#xe7b8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="RestoreBackupIcon" Text="&#xe777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />

    <TextBlock x:Key="RightArrowIcon" Text="&#xE974;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="LeftArrowIcon" Text="&#xE973;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />

    <TextBlock x:Key="ClearTextIcon" Text="&#xef00;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <TextBlock x:Key="SearchTextIcon" Text="&#xed11;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />

    <TextBlock x:Key="SidebarLibraryIcon" Text="&#xea8a;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <TextBlock x:Key="SidebarStatisticsIcon" Text="&#xEE93;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>

    <DataTemplate x:Key="ClearTextIconTemplate">
        <TextBlock Text="&#xeb90;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    </DataTemplate>

    <DataTemplate x:Key="SearchTextIconTemplate">
        <TextBlock Text="&#xe1a3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
    </DataTemplate>

    <BitmapImage x:Key="PlayniteLogo" UriSource="{ThemeFile 'Images/applogo.ico'}" popt:Freeze="True" />
    <BitmapImage x:Key="DefaultGameIcon" UriSource="{ThemeFile 'Images/icon.png'}" popt:Freeze="True" />
    <BitmapImage x:Key="DefaultGameCover" UriSource="{ThemeFile 'Images/cover.png'}" popt:Freeze="True" />

</ResourceDictionary>