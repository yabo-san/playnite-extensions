<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    mc:Ignorable="d">

    <Style TargetType="{x:Type ExplorerPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ExplorerPanel}">
                    <Border Background="Transparent"
                            d:DesignWidth="200"
                            d:DesignHeight="400">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Settings ShowSidebar}" Value="True">
                                        <Setter Property="Margin" Value="0,0,16,0" />
                                    </DataTrigger>                                   
                                    <DataTrigger Binding="{Settings ShowSidebar}" Value="False">
                                        <Setter Property="Margin" Value="16,0,16,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Background="{TemplateBinding Background}">
                            <ComboBox Name="PART_SelectFields" MaxDropDownHeight="Auto"
                                      DockPanel.Dock="Top" Style="{StaticResource ExplorerComboBox}"/>
                            <Separator Height="1" DockPanel.Dock="Top"
                                       BorderBrush="#1AFFFFFF"
                                       Focusable="False" SnapsToDevicePixels="True"/>
                            <ListBox Name="PART_SelectItems"
                                 DockPanel.Dock="Top" ItemContainerStyle="{StaticResource MenuListBoxItem}"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            </ListBox>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>