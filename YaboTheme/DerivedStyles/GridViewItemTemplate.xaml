 <ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- LEAN GRID CARD (grafted to kill the "webslop" per-card image loading).
         Mythos's original card wrapped the cover in an OpacityMask VisualBrush, loaded a
         per-card platform-source PNG from disk (ThemeFileBinding), painted a gradient overlay,
         and nested ~6 borders deep — so every card re-decoded/re-composited on each scroll frame.
         This version is the lean equivalent: the Playnite-cached cover Image + the hover
         play/info overlay + the cheap vector favorite/cloud cues. No mask, no per-card disk
         image load, no gradient, shallow tree. Native WPF bitmap behavior, recycles cleanly. -->

    <Style x:Key="GridViewItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Border BorderThickness="{Settings GridItemMargin}" BorderBrush="{DynamicResource GridItemBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadiusLarge}">
                        <StackPanel Name="PART_PanelHost"
                                    d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">

                            <Grid Width="{Settings GridItemWidth}" Height="{Settings GridItemHeight}">

                                <!-- [ROUNDED + FAST cover — PROVEN on hardware 2026-06-03] Keep the real PART_ImageCover as a
                                     hidden SOURCE carrier; paint its bitmap as a rounded Border BACKGROUND. A Border rounds its
                                     background in ONE normal draw — NOT a render-to-texture OpacityMask — so it's rounded AND
                                     keeps the lean-grid scroll smooth (best of both). Stretch is HARD-CODED (UniformToFill),
                                     NOT {Settings}, because a markup extension inside a Freezable brush throws.
                                     Do NOT change to OpacityMask (= the Mythos lag) or {Settings}-in-brush (= the crash). -->
                                <Image Name="PART_ImageCover" Visibility="Collapsed"/>
                                <Border CornerRadius="{DynamicResource GridCornerRadius}"
                                        RenderOptions.BitmapScalingMode="LowQuality">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Source, ElementName=PART_ImageCover}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>

                                <!-- Game Not Installed / no-cover states -->
                                <Border Background="Transparent" x:Name="TextGameName" Visibility="Collapsed"/>
                                <Border Background="#B3000000" x:Name="BorderMouseOver" Visibility="Collapsed"/>

                                <!-- Hover play / info overlay -->
                                <Border Name="GameControls"
                                        Visibility="Collapsed"
                                        CornerRadius="{DynamicResource GridCornerRadius}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Visibility, ElementName=PART_ButtonPlay}" Value="Visible">
                                                    <Setter Property="Background" Value="#80000000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Button Name="PART_ButtonInfo"
                                                Tag="{DynamicResource GridViewDetailsPanel}"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Margin="0"
                                                VerticalAlignment="Stretch"
                                                Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <Button Name="PART_ButtonPlay"
                                                Tag="{DynamicResource GridViewPlayButtons}"
                                                Content="&#xF5B0;"
                                                Style="{StaticResource GridViewPlayButton}"
                                                Focusable="False"
                                                Margin="0"
                                                Visibility="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Favorite cue (cheap vector glyph, no image load) -->
                                <Border Tag="{DynamicResource GridViewShowFavorites}" Background="{DynamicResource FavBrush}" Width="30" Height="30" CornerRadius="8" Margin="16,8,8,16"
                                        VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding Favorite}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="&#xE735;" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="{DynamicResource FontSizeLarge}" />
                                </Border>

                                <!-- Not-installed cloud cue (cheap vector Path, no image load) -->
                                <Border Tag="{DynamicResource GridViewCoverCloudIcon}"
                                        Background="Transparent"
                                        Width="30" Height="30"
                                        Margin="10,10,10,7"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        <Condition Binding="{Binding IsInstalled}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Data="{StaticResource CloudIconGeometry}"
                                        Fill="#BFFFFFFF"
                                        Width="22" Height="22"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>

                            </Grid>

                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter Property="Content" Value="&#xF0AE;" TargetName="PART_ButtonPlay" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderMouseOver" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CoverImage}" Value="{x:Null}" />
                                <Condition Binding="{Settings ShowNameEmptyCover}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="TextGameName"/>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="GameControls"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
