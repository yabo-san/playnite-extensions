<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Yabo Dev — OWNER-ONLY Playnite GenericPlugin (the publish tool).
    NEVER goes in the public bundle. Its absence from everyone else's install IS the security wall —
    so there is NO password/cheat-code gate. Whoever runs this is the owner.

    Right-click a game to toggle the `public` tag. Main menu Publish gathers every public-tagged
    Yabo card, asks for a patch note, and shells the engine's gated export-catalog command.
  -->

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>YaboDev</AssemblyName>
    <RootNamespace>YaboDev</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.16.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('icon.png')" />
  </ItemGroup>

</Project>
