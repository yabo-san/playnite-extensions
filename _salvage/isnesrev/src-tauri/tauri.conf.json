{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iSNESrev",
  "version": "0.1.0",
  "identifier": "com.yabo.isnesrev",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "iSNESrev",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": true,
        "dragDropEnabled": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
