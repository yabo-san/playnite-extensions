{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the iSNESrev main window — drives the yabo engine CLI",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "dialog:default",
    "shell:allow-open",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "engine",
          "cmd": "D:\\games\\yabo-portable\\yabo-launcher.exe",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "engine",
          "cmd": "D:\\games\\yabo-portable\\yabo-launcher.exe",
          "args": true
        }
      ]
    }
  ]
}
