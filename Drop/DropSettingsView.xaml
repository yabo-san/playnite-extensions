<UserControl x:Class="DropPlaynite.DropSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d1p1:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:d1p1="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <!-- DataContext is the DropSettingsViewModel; bindings target its .Settings. -->
    <StackPanel Margin="20">
        <TextBlock Text="Drop instance" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Instance URL" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Settings.BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{Binding SignInStatus}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="SignInButton" Content="Sign in with a code" Click="SignIn_Click" Padding="10,4" Margin="0,0,8,0"/>
            <Button x:Name="SignOutButton" Content="Sign out" Click="SignOut_Click" Padding="10,4"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,12"
                   Text="Sign in shows a short code. Enter it in Drop's web UI under Settings, Clients, and this Playnite becomes a Drop client. The credential is stored in this plugin's settings, the same way the Drop desktop app stores its own."/>

        <TextBlock Text="Install games to" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Settings.InstallRoot, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,16"
                   Text="Leave blank for %LOCALAPPDATA%\Playnite\Drop. Each game gets its own folder underneath."/>

        <TextBlock Text="Send to Drop (admins)" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Admin API token" Margin="0,0,0,4"/>
        <PasswordBox x:Name="AdminTokenBox" PasswordChanged="AdminToken_Changed" Margin="0,0,0,12"/>

        <TextBlock Text="Drop library folder, as seen from this machine (a share works)" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Settings.LibrarySharePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

        <TextBlock Text="Library id (optional, otherwise found from Drop's unimported list)" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Settings.LibraryId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

        <CheckBox Content="Hide games I sent to Drop from my own Drop cards"
                  IsChecked="{Binding Settings.HideUploaded}" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="UploadedCount" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Clear the sent list" Click="ClearUploaded_Click" Padding="10,4"/>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                   Text="With a token and a library folder set, every Playnite game gets a right-click item, Send to Drop: its install folder is copied into the library and imported. The original is never touched."/>
    </StackPanel>
</UserControl>
