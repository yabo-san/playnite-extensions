<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Style TargetType="{x:Type SearchBox}">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid Height="30">

                        <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource SearchSmallTextBox}"
                                 VerticalContentAlignment="Center" Padding="4,0,24,0"/>
                        <ContentControl x:Name="PART_SeachIcon" ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" FontSize="13"
                                        Foreground="{DynamicResource SubtalBrushLighter}" />
                        <ContentControl x:Name="PART_ClearTextIcon" ContentTemplate="{DynamicResource ClearTextIconTemplate}" 
                                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,2,8,0" FontSize="13"
                                        Foreground="{DynamicResource SubtalBrushLighter}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TopPanelSearchBox" TargetType="{x:Type SearchBox}" BasedOn="{StaticResource {x:Type SearchBox}}">
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Width" Value="{DynamicResource SearchBoxWidth}"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type SearchBox}">
                    <Grid x:Name="BoxGrid" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" ClipToBounds="False">
                        <TextBox x:Name="PART_TextInpuText" Style="{DynamicResource MythosSearchTextBox}" Width="{DynamicResource SearchBoxWidth}" HorizontalAlignment="Left"
                                VerticalContentAlignment="Center" Padding="10,0,30,1"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ContentControl x:Name="PART_SeachIcon" ContentTemplate="{DynamicResource SearchTextIconTemplate}"
                                            FontSize="16" VerticalAlignment="Center" Margin="8,0,8,0"
                                            Foreground="{DynamicResource ControlContrastBorderBrushBrightest}"/>
                            <TextBlock x:Name="Prompt" Text="{DynamicResource LOCMythos_Search}" FontFamily="{DynamicResource FontFamily}"
                                    FontSize="15" VerticalAlignment="Center"
                                    Foreground="{DynamicResource ControlContrastBorderBrushBrightest}"/>
                        </StackPanel>
                        <ContentControl x:Name="PART_ClearTextIcon"
                                        ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                                        FontSize="{DynamicResource FontSizeLarge}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                                        Foreground="{DynamicResource ControlContrastBorderBrushBrightest}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding ElementName=PART_SeachIcon, Path=Visibility}" Value="Collapsed">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="Prompt"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>