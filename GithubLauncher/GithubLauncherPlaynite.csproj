<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GithubLauncher for Playnite.

    Scans the install folder rather than reading library.db: on a real install that
    database is empty while the games are all on disk, so the folder is the only
    source of truth. Which .exe is the game is decided by ExePicker, tuned against
    a real 19-game library.

    Build: dotnet build -c Release  ->  bin\Release\net462\GithubLauncherPlaynite.dll
  -->

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>GithubLauncherPlaynite</AssemblyName>
    <RootNamespace>GithubLauncherPlaynite</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference-only: Playnite supplies both at runtime, so neither is copied out. -->
    <PackageReference Include="PlayniteSDK" Version="6.16.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

